# Animator Workspace / routine-appと同じSupabaseプロジェクトの値を使う
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gmail連携用(アプリ内の「Gmailアカウントを追加」ボタンから複数アカウントを接続できる。
# GOOGLE_CLIENT_ID/SECRETは全アカウント共通の同一OAuthクライアントを使い回す)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 接続したGmailアカウントのrefresh tokenをDBに保存する際の暗号化キー。
# openssl rand -base64 32 で生成した32バイトのbase64値を設定する。
GMAIL_TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# AI分類・抽出
GEMINI_API_KEY=your-gemini-api-key

# GitHub Actions(または将来のVercel Cron)からのポーリング呼び出しを認証する秘密値
CRON_SECRET=generate-a-random-secret

# UnyaListにログインする(Supabase Google OAuthの)個人アカウントのメールアドレス。
# cronがこのメールアドレスのuser_idに紐づけてinquiriesを保存する。
UNYALIST_OWNER_EMAIL=you@example.com

# 「仕事依頼らしさ」スコアの表示しきい値(0〜1、未満は非依頼として非表示保存)
CONFIDENCE_THRESHOLD=0.6
